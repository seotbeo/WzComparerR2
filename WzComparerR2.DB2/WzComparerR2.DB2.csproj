<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net6.0-windows;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WzComparerR2.DB2</AssemblyName>
    <RootNamespace>WzComparerR2.DB2</RootNamespace>
    <IsPublishable>false</IsPublishable>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <WcR2Plugin>true</WcR2Plugin>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>
  <Import Project="$(ProjectDir)..\Build\Common.props" />
  <ItemGroup Condition="$(DotnetEdition) == 'framework'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Configuration" />
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WzComparerR2.Common\WzComparerR2.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\WzComparerR2.PluginBase\WzComparerR2.PluginBase.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\WzComparerR2.WzLib\WzComparerR2.WzLib.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <!-- 只用到主程式的 BassSoundPlayer；與 Avatar / MapRender 相同，僅編譯期參考不複製。 -->
    <ProjectReference Include="..\WzComparerR2\WzComparerR2.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <Reference Include="DevComponents.DotNetBar2">
      <HintPath>..\References\DevComponents.DotNetBar2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="System.Resources.Extensions" Version="$(SystemResourcesExtensionsVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\Build\CommonAssemblyInfo.cs')">
    <Compile Include="..\Build\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DB2Form.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DB2Form.designer.cs">
      <DependentUpon>DB2Form.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="DB2Form.resx">
      <DependentUpon>DB2Form.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="IconsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="IconsForm.designer.cs">
      <DependentUpon>IconsForm.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <EmbeddedResource Update="IconsForm.resx">
      <DependentUpon>IconsForm.cs</DependentUpon>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>IconsForm.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="ImageViewerForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ImageViewerForm.designer.cs">
      <DependentUpon>ImageViewerForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ImageViewerForm.resx">
      <DependentUpon>ImageViewerForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="DataGrid.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(ProjectDir)..\Build\WcR2Plugin.targets" />
</Project>
